# ─────────────────────────────────────────────
# OpenSwarm — Ollama Cloud Edition
# Copy this to .env and fill in your keys.
# ─────────────────────────────────────────────

# Route ALL models through LiteLLM to Ollama Cloud
# Available models (check with `ollama list`):
#   deepseek-v4-pro:cloud, kimi-k2.6:cloud, qwen3.5:397b-cloud,
#   mistral-large-3:675b-cloud, minimax-m2.7:cloud, nemotron-3-super:cloud,
#   gpt-oss:120b-cloud, glm-5:cloud
DEFAULT_MODEL=ollama_chat/minimax-m2.7:cloud

# Ollama endpoint (local WSL shim that proxies to cloud)
OLLAMA_API_BASE=http://localhost:11434

# Pass through to LiteLLM (Ollama doesn't auth, but LiteLLM needs a key)
OPENAI_API_KEY=ollama

# ── Optional: Stock photo APIs ───────────────
# ImageSearch uses these to pull real photos into slides/docs.
# All three have free tiers. Leave blank to skip.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Optional: Search ─────────────────────────
# ScholarSearch + web search (searchapi.io)
SEARCH_API_KEY=

# ── Optional: Anthropic (better slide quality) ─
# If set, Slide Planner + HTML Writer use Claude instead of Ollama.
ANTHROPIC_API_KEY=
